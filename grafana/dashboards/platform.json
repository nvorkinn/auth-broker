          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "{service=\"caddy\"} ${filter} level:in(error,fatal) | stats count() errors",
          "queryType": "stats"
