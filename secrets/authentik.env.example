# authentik's secrets; on the host they come from secrets/<environment>/authentik.env
# (SOPS-encrypted). Generate them with:
#   openssl rand -hex 50   (AUTHENTIK_SECRET_KEY)
#   openssl rand -hex 32   (the database password, the same value twice below)
# The database password is fixed when the database is first created, so keep
# the one already in use.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRESQL__PASSWORD=
POSTGRES_PASSWORD=
# Resend's API key (https://resend.com/api-keys), the SMTP password for authentik's email (sign-up
# confirmation, password recovery); the other AUTHENTIK_EMAIL__* settings are in docker-compose.yml.
# Without it no email is sent, and nobody can finish signing up.
AUTHENTIK_EMAIL__PASSWORD=
