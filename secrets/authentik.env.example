# Authentik's secrets; on the host they come from secrets/authentik.env
# (SOPS-encrypted). Generate them with:
#   openssl rand -hex 50   (AUTHENTIK_SECRET_KEY)
#   openssl rand -hex 32   (the database password, the same value twice below)
# The database password is fixed when the database is first created, so keep
# the one already in use.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRESQL__PASSWORD=
POSTGRES_PASSWORD=
# Read by authentik/authentik-config.yaml (with !Env) when the
# deploy-authentik-config job applies it: the OAuth2 client secrets of the
# Logs and Metrics providers, and the Google login source's OAuth client
# (Google Cloud console > Credentials; redirect URI
# https://sso.nikolaivorkinn.com/source/oauth/callback/google/).
BLUEPRINT_LOGS_CLIENT_SECRET=
BLUEPRINT_METRICS_CLIENT_SECRET=
BLUEPRINT_GOOGLE_CLIENT_ID=
BLUEPRINT_GOOGLE_CLIENT_SECRET=
# Resend's API key (https://resend.com/api-keys), the SMTP password for the email Authentik sends: the
# sign-up's confirmation link and password recovery. The other AUTHENTIK_EMAIL__* settings are in
# docker-compose.yml. Without it, no email is sent, and nobody can finish signing up.
AUTHENTIK_EMAIL__PASSWORD=
