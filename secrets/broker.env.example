# The broker's secrets. On the host they come from secrets/broker.env, which is
# SOPS-encrypted (see "Secrets" in the README); for local development copy this
# to .env and fill it in.
FLASK_SECRET_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music (optional): a MusicKit key from an Apple Developer Program account (Certificates, Identifiers &
# Profiles > Keys, with Media Services/MusicKit ticked). The Team ID, the key's ID, and the .p8 file's text,
# newlines and all. Leave them empty to keep Apple Music off the config page.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Encrypts stored third-party credentials (e.g. Glowmarkt) at rest. Losing it loses
# those credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# TfL's app key, for the settings page's stop search and naming saved stops. It never leaves
# the broker: pi-dashboard's TfL providers have their own (its deploy's TFL_APP_KEY secret).
TFL_APP_KEY=

# Bearer token for the read-only GET /api/status/devices (e.g. for Home Assistant). Leave it
# empty to keep that endpoint off. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STATUS_TOKEN=

# Personal dashboard at /github. Both are required; other signed-in users are refused.
# Authentik's X-Authentik-Uid for your account (the same identity used for device ownership).
GITHUB_DASHBOARD_USER_ID=
# Fine-grained GitHub PAT: Contents and Deployments read/write; Actions, Checks, Commit statuses and Pull requests read.
# Select all repositories you want monitored. Never put this token in browser code or compose settings.
GITHUB_DASHBOARD_TOKEN=
