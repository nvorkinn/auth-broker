# The broker's secrets. On the host they come from secrets/broker.env, which is
# SOPS-encrypted (see "Secrets" in the README); for local development copy this
# to .env and fill it in.
FLASK_SECRET_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Encrypts stored third-party credentials (e.g. Glowmarkt) at rest. Losing it loses
# those credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Shared app-level API keys, handed out to every paired device via /api/devices/<id>/config
TFL_APP_KEY=
WEATHER_API_KEY=

# Bearer token for the read-only GET /api/status/devices (e.g. for Home Assistant). Leave it
# empty to keep that endpoint off. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STATUS_TOKEN=
