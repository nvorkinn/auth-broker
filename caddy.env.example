# Bearer token a client must send to ingest logs at logs.nikolaivorkinn.com (see caddy/Caddyfile).
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LOGS_INGEST_TOKEN=

# Value a client must send in the X-Logs-Admin header to query logs under /select/*.
# Generate the same way as above.
LOGS_ADMIN_TOKEN=
