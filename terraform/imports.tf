# Most of what this config manages already exists in Authentik, so the first plan imports it instead of creating it:
# the import blocks sit beside their resources. The ids are generated by Authentik, so they are looked up from the live
# server by name (scripts/authentik_ids.py). Once an apply has put everything in the state the import blocks do nothing
# and can be deleted. `local.ids` stays: it also finds the stock objects this config only refers to.
data "external" "ids" {
  program = ["python3", "${path.module}/scripts/authentik_ids.py"]
  query = {
    url = var.authentik_url
  }
}

locals {
  # Maps of name (slug, domain...) to id for each kind of object, e.g. local.ids.flows["default-recovery-flow"].
  ids = { for kind, ids in data.external.ids.result : kind => jsondecode(ids) }
}
