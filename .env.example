# Image tag docker compose runs (see "Deploying" in the README); pin it rather than tracking latest.
AUTH_BROKER_VERSION=v1.8.0
# Caddy image tag; it's released alongside the broker, so normally the same tag.
CADDY_VERSION=v1.8.0

FLASK_SECRET_KEY=
# Domain the pairing session cookie is scoped to. The leading dot shares it with every subdomain
# (e.g. for /api/logging_ui/verify behind logs.); leave it empty for a host-only cookie.
# If you scope to a parent domain, keep Secure enabled and set SameSite explicitly.
SESSION_COOKIE_DOMAIN=.nikolaivorkinn.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://auth.nikolaivorkinn.com/auth/spotify/callback

# Encrypts stored third-party credentials (e.g. Glowmarkt) at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Shared app-level API keys, handed out to every paired device via /api/devices/<id>/config
TFL_APP_KEY=
WEATHER_API_KEY=

# Bearer token for the read-only GET /api/status/devices (e.g. for Home Assistant). Leave it
# empty to keep that endpoint off. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STATUS_TOKEN=
