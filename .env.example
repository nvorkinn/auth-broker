# The image tags docker compose runs (see "Deploying" in the README). deploy.sh
# pins each to the release it deploys and drops anything else from this file:
# secrets are in secrets/ and settings in docker-compose.yml.
COUNTDOWN_SERVER_VERSION=v1.8.0
CADDY_VERSION=v1.8.0
FLUENT_BIT_VERSION=v1.8.0
VICTORIA_LOGS_VERSION=v1.8.0
VICTORIA_METRICS_VERSION=v1.8.0
# Upstream authentik's release, bumped by hand one minor version at a time.
AUTHENTIK_VERSION=2026.8.4
