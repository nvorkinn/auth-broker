# Image tags docker compose runs (see "Deploying" in the README). deploy.sh pins
# each one to the release it deploys, and drops anything else from this file:
# secrets live in secrets/ (SOPS-encrypted) and settings in docker-compose.yml.
AUTH_BROKER_VERSION=v1.8.0
CADDY_VERSION=v1.8.0
FLUENT_BIT_VERSION=v1.8.0
VICTORIA_LOGS_VERSION=v1.8.0
VICTORIA_METRICS_VERSION=v1.8.0
# Upstream Authentik release, bumped by hand one minor version at a time.
AUTHENTIK_VERSION=2026.8.3
