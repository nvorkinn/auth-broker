# Decrypted env files, on the host or for local development. The encrypted
# copies in secrets/ are committed.
/.env
/broker.env
/caddy.env
/authentik.env
/redis.env
data/
__pycache__/
*.pyc
.venv/
.idea/
.coverage
coverage.xml
htmlcov/
