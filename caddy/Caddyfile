# Only admins get in (an authentik login in the admin group, by forward auth),
# then proxied to the upstream given, e.g. `import admin_only 127.0.0.1:9428`.
(admin_only) {
	reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9000
	forward_auth 127.0.0.1:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email
		trusted_proxies private_ranges
	}
	reverse_proxy {args[0]}
}

# QA tracing: with LOG_REQUEST_HEADERS=true (docker-compose.yml), every request to the two hosts a
# sign-in passes through is logged as JSON with its headers and the response's, which show each
# redirect's Location. Caddy redacts Authorization, Cookie and Set-Cookie unless `log_credentials`
# is set in the global options.
(access_log) {
	log {
		output stdout
		format json
	}
	@request_logging_off expression `'{$LOG_REQUEST_HEADERS:false}' != 'true'`
	log_skip @request_logging_off
}

# The bare domain has nothing of its own: send it to the settings site, keeping the path (so
# nikolaivorkinn.com/about works). A temporary redirect, so browsers don't remember it if the apex
# ever gets a page. Needs A records for both names pointing at this host, or Caddy can't get a cert.
nikolaivorkinn.com, www.nikolaivorkinn.com {
	redir https://auth.nikolaivorkinn.com{uri}
}

# Caddy uses host networking, so 127.0.0.1 is the host throughout.
auth.nikolaivorkinn.com {
	import access_log

	# The broker trusts X-Authentik-Uid as the signed-in user (and shows the username), so nothing a
	# visitor sends in these may get through: strip them from every request, and let forward auth set
	# them on the browser pages.
	request_header -X-Authentik-Uid
	request_header -X-Authentik-Username
	request_header -X-Authentik-Email

	# Most frame answers are 304s, which through Caddy have no Content-Length, so the ESP32 reads until
	# the connection closes: Caddy's idle timeout, 5 minutes. The screen opens a new connection for every
	# poll anyway, so close each one after its answer.
	header /api/frame Connection close

	# Everything but the screens' API (Bearer secrets), the status endpoint (its own token) and the
	# public /about page with its pictures needs an authentik login. /api/stops and /api/places are
	# browser calls.
	@browser {
		not path /api/frame /api/frame/* /api/devices/* /api/status/* /about /static/display/*
	}
	handle @browser {
		reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9000
		forward_auth 127.0.0.1:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Uid X-Authentik-Username X-Authentik-Email
			trusted_proxies private_ranges
		}
		reverse_proxy 127.0.0.1:5000
	}
	handle {
		reverse_proxy 127.0.0.1:5000
	}
}

# VictoriaLogs, the victoria-logs compose service.
logs.nikolaivorkinn.com {
	@ingest {
		path /insert/*
		header Authorization "Bearer {$LOGS_INGEST_TOKEN}"
	}
	handle @ingest {
		reverse_proxy 127.0.0.1:9428
	}

	handle {
		import admin_only 127.0.0.1:9428
	}
}

# VictoriaMetrics, the victoria-metrics compose service, with the same ingest
# token as logs.
metrics.nikolaivorkinn.com {
	@ingest {
		path /api/v1/write /api/v1/import /api/v1/import/* /influx/*
		header Authorization "Bearer {$LOGS_INGEST_TOKEN}"
	}
	handle @ingest {
		reverse_proxy 127.0.0.1:8428
	}

	handle {
		import admin_only 127.0.0.1:8428
	}
}

sso.nikolaivorkinn.com {
	import access_log
	# authentik, published on loopback only.
	reverse_proxy 127.0.0.1:9000
}
