# Only admins get in: an Authentik login in the admin group (forward auth),
# then proxied to the upstream given as the argument, e.g.
# `import admin_only 127.0.0.1:9428`.
(admin_only) {
	reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9000
	forward_auth 127.0.0.1:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email
		trusted_proxies private_ranges
	}
	reverse_proxy {args[0]}
}

# QA tracing: with LOG_REQUEST_HEADERS=true in Caddy's environment (set in docker-compose.yml, with the
# broker's), every request to the two hosts a sign-in passes through is logged as JSON with all its
# headers and the response's, which is where each redirect's Location shows. Caddy redacts
# Authorization, Cookie and Set-Cookie unless `log_credentials` is set in the global options.
# With anything else, `log_skip` drops the access log.
(access_log) {
	log {
		output stdout
		format json
	}
	@request_logging_off expression `'{$LOG_REQUEST_HEADERS:false}' != 'true'`
	log_skip @request_logging_off
}

# Caddy uses host networking, so 127.0.0.1 is the host throughout.
auth.nikolaivorkinn.com {
	import access_log

	# The broker trusts X-Authentik-Uid as the signed-in user (and shows the username and email), so
	# nothing a visitor sends in them may get through: strip them from every request, and let forward
	# auth set them on the browser pages.
	request_header -X-Authentik-Uid
	request_header -X-Authentik-Username
	request_header -X-Authentik-Email

	# Everything but the device API (Bearer secrets, no login), the status endpoint (its own token),
	# the orchestrator's (its own too) and the public page about the display (/about and its pictures)
	# is for browsers and needs an Authentik login. The stop search under /api/tfl is a browser call.
	@browser {
		not path /api/config /api/frame /api/frame/* /api/devices/* /api/renderers/* /api/status/* /api/orchestrator/* /about /static/display/*
	}
	handle @browser {
		reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9000
		forward_auth 127.0.0.1:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Uid X-Authentik-Username X-Authentik-Email
			trusted_proxies private_ranges
		}
		# The broker's published port.
		reverse_proxy 127.0.0.1:5000
	}
	handle {
		reverse_proxy 127.0.0.1:5000
	}
}

# VictoriaLogs, the victoria-logs compose service.
logs.nikolaivorkinn.com {
	@ingest {
		path /insert/*
		header Authorization "Bearer {$LOGS_INGEST_TOKEN}"
	}
	handle @ingest {
		reverse_proxy 127.0.0.1:9428
	}

	handle {
		import admin_only 127.0.0.1:9428
	}
}

# VictoriaMetrics, the victoria-metrics compose service. Pushes use the same
# ingest token as logs.
metrics.nikolaivorkinn.com {
	@ingest {
		path /api/v1/write /api/v1/import /api/v1/import/* /influx/*
		header Authorization "Bearer {$LOGS_INGEST_TOKEN}"
	}
	handle @ingest {
		reverse_proxy 127.0.0.1:8428
	}

	handle {
		import admin_only 127.0.0.1:8428
	}
}

sso.nikolaivorkinn.com {
	import access_log
	# Authentik, published on loopback only.
	reverse_proxy 127.0.0.1:9000
}
